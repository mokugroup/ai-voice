# LiveKit
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
ROOM_NAME=hera-voice
VOICE_USER_NAME=User
VOICE_USER_PRONUNCIATION=User
ORGANISATION_NAME=MOKU Digital

# Speech services
DEEPGRAM_API_KEY=replace_with_deepgram_api_key

# OpenClaw's OpenAI-compatible gateway
GATEWAY_URL=http://127.0.0.1:18789
GATEWAY_TOKEN=replace_with_gateway_token
GATEWAY_MODEL=openclaw/hera
GATEWAY_USER=moku-digital

# Web server
PORT=8080
HTTPS_PORT=8443
ENABLE_LOCAL_TLS=false

# Optional local TLS. Certificate and key files are ignored by Git.
TAILSCALE_TLS_DOMAIN=
TAILSCALE_CERT_DIR=./tailscale-certs
TLS_CERT=
TLS_KEY=

# Persistent voice-session handoff inside the agent container
VOICE_CONTINUITY_DIR=/app/data
VOICE_SHARED_CONTINUITY_FILE=/workspace/memory/voice-session-continuity.md
